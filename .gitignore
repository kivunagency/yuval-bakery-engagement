# Python
__pycache__/
*.pyc
*.pyo
venv/
.venv/

# Environment variables (secrets — NEVER commit)
# CAUTION (Egoz-Maniv 2026-07-03): the Vercel CLI (`vercel env pull`) writes env files WITHOUT a
# leading dot — env.local, env.prod-local, env.vercel-local — which ".env*" does NOT match. That
# leaked a live Supabase service_role key into git. Match BOTH dotted and dot-less forms:
.env
.env*
.env.local
.env.*.local
env
env.local
env.prod-local
env.vercel-local
env*.local
env.*-local
# keep template files tracked:
!.env.example
!.env.local.example
!env.local.example
# Managed QA user (Rule 22, qa-005): the filled file is a credential, the example is not
.qa.env
!.qa.env.example

# Vercel
.vercel

