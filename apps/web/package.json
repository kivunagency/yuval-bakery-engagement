{
  "name": "yuval-bakery-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test -c qa/playwright.config.js",
    "stack:up": "bash scripts/local-stack/up.sh",
    "stack:down": "bash scripts/local-stack/down.sh",
    "check:dashes": "python3 scripts/check-dashes.py"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-hebrew": "5.3.0",
    "@fontsource/karantina": "5.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "next": "15.5.26",
    "next-intl": "4.14.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.26",
    "jose": "6.2.12",
    "pg": "8.23.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
